# Required for live agent calls
GROQ_API_KEY=replace-me

# Optional model override
GROQ_MODEL=openai/gpt-oss-20b

# Optional LangSmith tracing (never commit real keys)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-me
LANGSMITH_PROJECT=nj-real-estate-intelligence

# Restrict checkpoint deserialization to safe built-in/model types
LANGGRAPH_STRICT_MSGPACK=true
